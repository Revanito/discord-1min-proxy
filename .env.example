ONE_MIN_API_KEY=your_1min_ai_api_key
PROXY_SHARED_SECRET=choose_a_long_random_string

# Model used per question difficulty tier (auto-classified by MODEL_CLASSIFIER).
# Easy/medium favor xAI's fast models for quick, human-sounding replies; hard uses
# the xAI flagship for questions that need real reasoning. Full list in MODELS.md.
MODEL_EASY=grok-4-fast-non-reasoning
MODEL_MEDIUM=grok-4-fast-reasoning
MODEL_HARD=grok-4.5
MODEL_CLASSIFIER=gpt-4o-mini

DISCORD_BOT_TOKEN=your_discord_bot_token
ALLOWED_GUILD_IDS=
# Set to your test server's ID for instant slash-command sync while developing.
# Leave empty for a global sync (can take up to ~1 hour to propagate).
DEV_GUILD_ID=
