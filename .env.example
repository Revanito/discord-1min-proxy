ONE_MIN_API_KEY=your_1min_ai_api_key
PROXY_SHARED_SECRET=choose_a_long_random_string

# Model used per (category, difficulty) cell, auto-classified in one call by MODEL_CLASSIFIER.
# category: code (programming/IT) -> Anthropic, specific (factual/knowledge) -> OpenAI,
# general (everything else) -> xAI, kept for its conversational tone. Full list in MODELS.md.
MODEL_CODE_EASY=claude-haiku-4-5-20251001
MODEL_CODE_MEDIUM=claude-sonnet-4-6
MODEL_CODE_HARD=claude-opus-4-6

MODEL_GENERAL_EASY=grok-4-fast-non-reasoning
MODEL_GENERAL_MEDIUM=grok-4-fast-reasoning
MODEL_GENERAL_HARD=grok-4.5

MODEL_SPECIFIC_EASY=gpt-5-mini
MODEL_SPECIFIC_MEDIUM=gpt-5.4-mini
MODEL_SPECIFIC_HARD=gpt-5.2

MODEL_CLASSIFIER=gpt-4o-mini

DISCORD_BOT_TOKEN=your_discord_bot_token
ALLOWED_GUILD_IDS=
# /ask in DMs is denied by default (opposite of ALLOWED_GUILD_IDS above) - list your own
# Discord user ID here (right-click your name with Developer Mode on -> Copy User ID) to
# allow yourself to DM the bot directly. Comma-separated for multiple users.
ALLOWED_DM_USER_IDS=
# Set to your test server's ID for instant slash-command sync while developing.
# Leave empty for a global sync (can take up to ~1 hour to propagate).
DEV_GUILD_ID=